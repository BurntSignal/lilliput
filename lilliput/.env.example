# Copy to .env, then change only the settings you want.
HOST=0.0.0.0
PORT=8788
LILLIPUT_TIMEZONE=America/New_York
# Standalone local runs save to ./data/lilliput.sqlite. systemd saves to /var/lib/lilliput.
# WORLD_DB=/path/to/lilliput.sqlite

# Optional: an existing Ollama server and installed model (disabled by default).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=YOUR_INSTALLED_MODEL
# AI_INTERVAL_SECONDS=600
